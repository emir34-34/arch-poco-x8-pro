# QEMU test only: after the boot settles, report into the kernel log (the
# serial console) and power off
[Unit]
Description=QEMU test report
After=multi-user.target

[Service]
Type=oneshot
Environment=QTEST_WAIT=150
ExecStart=/bin/sh -c 'sleep ${QTEST_WAIT:-40}; { echo BEGIN; systemd-analyze; systemctl --failed --no-pager --plain; systemctl list-jobs --no-pager; journalctl -b --no-pager -o cat -u klee-testscreen -u klee-selftest | tail -40; cat /run/klee-test/status; echo END; } 2>&1 | while IFS= read -r l; do echo "QR: $l" > /dev/kmsg; done; systemctl poweroff'
