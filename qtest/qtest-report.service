# QEMU test only: after the boot settles, report into the kernel log (the
# serial console) and power off
[Unit]
Description=QEMU test report
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sleep 40; { echo BEGIN; systemd-analyze; systemctl --failed --no-pager --plain; systemctl list-jobs --no-pager; journalctl -b --no-pager -o cat -u mount-android-partitions | tail -40; journalctl -b --no-pager -o cat -u bluebinder | tail -8; echo END; } 2>&1 | while IFS= read -r l; do echo "QR: $l" > /dev/kmsg; done; systemctl poweroff'
