# klee: same version as the working UT 24.04 install
pkgname=libglibutil
pkgver=1.0.79
pkgrel=1
pkgdesc="GLib utilities (Sailfish OS)"
arch=(aarch64)
url="https://github.com/sailfishos/libglibutil"
license=(BSD-3-Clause)
depends=(glib2)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=(SKIP)

build() {
	cd $pkgname-$pkgver
	make CC="$CC" KEEP_SYMBOLS=1 PKG_CONFIG="$PKG_CONFIG" release pkgconfig
}

package() {
	cd $pkgname-$pkgver
	make DESTDIR="$pkgdir" LIBDIR=/usr/lib install-dev
}
