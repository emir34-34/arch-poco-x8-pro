# klee: Android audio HAL modules for PulseAudio, the version Ubuntu Touch
# 24.04 ran (14.2.106), built against Arch's PulseAudio 17 (pulsecore-headers).
# (UT's packaging renamed them module-droid-card-30 etc.; here plain names)
pkgname=pulseaudio-modules-droid
pkgver=14.2.106
pkgrel=1
pkgdesc="PulseAudio modules for Android audio HALs (through libhybris)"
arch=(aarch64)
url="https://github.com/mer-hybris/pulseaudio-modules-droid"
license=(LGPL-2.1-or-later)
depends=(pulseaudio libhybris expat alsa-lib systemd-libs libevdev)
makedepends=(meson pulsecore-headers android-headers)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=(SKIP)

build() {
	cd $pkgname-$pkgver
	echo "$pkgver" > .tarball-version
	meson setup build --cross-file "$KLEE_XENV/cross.ini" --prefix=/usr --libdir=lib \
		--buildtype=release -Dmodlibexecdir=/usr/lib/pulseaudio/modules
	meson compile -C build
}

package() {
	cd $pkgname-$pkgver
	meson install -C build --destdir "$pkgdir"
}
