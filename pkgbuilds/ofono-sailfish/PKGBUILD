# klee: Sailfish OS's oFono at the version Ubuntu Touch 24.04 ran on this
# phone (1.29+git12), with the same features (no Sailfish-only access/BT/
# push-forwarder plugins: UT's ofonod linked only glib, dbus, udev, glibutil).
# Modems come from ofono-binder-plugin (Android radio HAL over binder).
pkgname=ofono-sailfish
pkgver=1.29+git12
pkgrel=1
pkgdesc="Telephony daemon (Sailfish OS fork, for Android radio HALs)"
arch=(aarch64)
url="https://github.com/sailfishos/ofono"
license=(GPL-2.0-only)
depends=(glib2 dbus dbus-glib systemd-libs libglibutil)
provides=(ofono)
conflicts=(ofono)
source=("ofono::git+https://github.com/sailfishos/ofono#tag=$pkgver")
sha256sums=(SKIP)

build() {
	cd ofono/ofono
	autoreconf --force --install
	./configure --host=aarch64-unknown-linux-gnu --prefix=/usr --sysconfdir=/etc \
		--localstatedir=/var --libexecdir=/usr/lib --sbindir=/usr/bin \
		--disable-static --enable-test \
		--disable-sailfish-bt --disable-sailfish-access --disable-sailfish-pushforwarder \
		--disable-sailfish-debuglog --disable-add-remove-context \
		--disable-rilmodem --disable-isimodem --disable-qmimodem --disable-bluetooth \
		--with-systemdunitdir=/usr/lib/systemd/system
	make -j"$(nproc)"
}

package() {
	cd ofono/ofono
	make DESTDIR="$pkgdir" install
}
