diff --git a/kernel/fork.c b/kernel/fork.c
index b909fa1cc..40ef39ad4 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -1057,6 +1057,16 @@ static void set_max_threads(unsigned int max_threads_suggested)
 int arch_task_struct_size __read_mostly;
 #endif
 
+#ifdef CONFIG_SYSVIPC
+/*
+ * Offsets (within the overallocated task_struct slab slot) of the SYSVIPC
+ * fields that we deliberately keep outside struct task_struct. See the
+ * comment in include/linux/sched.h.
+ */
+size_t __task_sysvsem_offset __ro_after_init;
+size_t __task_sysvshm_offset __ro_after_init;
+#endif
+
 #ifndef CONFIG_ARCH_TASK_STRUCT_ALLOCATOR
 static void task_struct_whitelist(unsigned long *offset, unsigned long *size)
 {
@@ -1083,11 +1093,28 @@ void __init fork_init(void)
 #endif
 	int align = max_t(int, L1_CACHE_BYTES, ARCH_MIN_TASKALIGN);
 	unsigned long useroffset, usersize;
+	size_t task_struct_size = arch_task_struct_size;
+
+#ifdef CONFIG_SYSVIPC
+	/*
+	 * Reserve room for sysv_sem / sysv_shm past the end of struct
+	 * task_struct. Precompiled GKI vendor modules sometimes overrun the
+	 * ANDROID_KABI_RESERVE slots; keeping the SYSVIPC state outside the
+	 * struct prevents such overruns from corrupting it.
+	 */
+	task_struct_size = ALIGN(task_struct_size, __alignof__(struct sysv_sem));
+	__task_sysvsem_offset = task_struct_size;
+	task_struct_size += sizeof(struct sysv_sem);
+
+	task_struct_size = ALIGN(task_struct_size, __alignof__(struct sysv_shm));
+	__task_sysvshm_offset = task_struct_size;
+	task_struct_size += sizeof(struct sysv_shm);
+#endif
 
 	/* create a slab on which task_structs can be allocated */
 	task_struct_whitelist(&useroffset, &usersize);
 	task_struct_cachep = kmem_cache_create_usercopy("task_struct",
-			arch_task_struct_size, align,
+			task_struct_size, align,
 			SLAB_PANIC|SLAB_ACCOUNT,
 			useroffset, usersize, NULL);
 #endif
