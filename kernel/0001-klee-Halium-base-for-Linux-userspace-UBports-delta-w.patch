diff --git a/include/linux/sched.h b/include/linux/sched.h
index 6d6824770..f92aa66ea 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -1072,10 +1072,15 @@ struct task_struct {
 
 	struct nameidata		*nameidata;
 
-#ifdef CONFIG_SYSVIPC
-	struct sysv_sem			sysvsem;
-	struct sysv_shm			sysvshm;
-#endif
+	/*
+	 * SYSVIPC state (sysv_sem / sysv_shm) is not a member of task_struct
+	 * in this build: precompiled GKI vendor modules occasionally overrun
+	 * the ANDROID_KABI_RESERVE slots, which would corrupt those fields if
+	 * they lived inside the struct. Instead, the task_struct slab slot is
+	 * overallocated and the SYSVIPC fields are placed past the end of the
+	 * struct. Access them via task_sysvsem() / task_sysvshm().
+	 */
+
 #ifdef CONFIG_DETECT_HUNG_TASK
 	unsigned long			last_switch_count;
 	unsigned long			last_switch_time;
@@ -1562,6 +1567,26 @@ struct task_struct {
 	 */
 };
 
+#ifdef CONFIG_SYSVIPC
+/*
+ * SYSVIPC state lives in the trailing area of the task_struct slab slot,
+ * past sizeof(struct task_struct). The slab is overallocated in fork_init()
+ * so that vendor module overruns into ANDROID_KABI_RESERVE cannot reach it.
+ */
+extern size_t __task_sysvsem_offset;
+extern size_t __task_sysvshm_offset;
+
+static inline struct sysv_sem *task_sysvsem(struct task_struct *tsk)
+{
+	return (struct sysv_sem *)((char *)tsk + __task_sysvsem_offset);
+}
+
+static inline struct sysv_shm *task_sysvshm(struct task_struct *tsk)
+{
+	return (struct sysv_shm *)((char *)tsk + __task_sysvshm_offset);
+}
+#endif
+
 static inline struct pid *task_pid(struct task_struct *task)
 {
 	return task->thread_pid;
